<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_PATH" value="./logs"/>
    <!-- 1) 플래그: 미정의면 false -->
    <property name="LOGSTASH_ENABLE" value="${logstash.enabled:-false}"/>
    <define name="hostname" class="ch.qos.logback.core.property.CanonicalHostNamePropertyDefiner"/>

    <!-- Appenders -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%-5level] [%thread] [userId:%X{userId}] [%X{traceId}][%X{clientIp}][%X{requestUrl}] %logger %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="INFO_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
        <file>${LOG_PATH}/info.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/info_${type}.%d{yyyy-MM-dd}.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%-5level] [%thread] [userId:%X{userId}] [%X{traceId}][%X{clientIp}][%X{requestUrl}] %logger %msg%n</pattern>
        </encoder>
    </appender>

    <!-- LOGSTASH_HOST가 정의된 경우에만 LOGSTASH appender 생성/부착 -->
    <if condition='property("LOGSTASH_ENABLE").equalsIgnoreCase("true")'>
            <then>
                <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
                    <destination>${LOGSTASH_HOST:-127.0.0.1}:${LOGSTASH_PORT:-4560}</destination>

                    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                        <!-- MDC 전부 포함은 기본 동작이지만, 명시 가능 -->
                        <includeMdc>true</includeMdc>


                        <!-- 예외 + 스택트레이스 -->
                        <stackTrace>
                            <!-- 원하면 단축/필터 가능 -->
                            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                                <maxDepthPerThrowable>200</maxDepthPerThrowable>
                                <maxLength>20000</maxLength>
                                <rootCauseFirst>true</rootCauseFirst>
                            </throwableConverter>
                        </stackTrace>

                        <customFields>
                            {"service":"uat-trade-api","env":"local", "host":{"hostname":"${hostname}"}}
                        </customFields>
                    </encoder>

                    <ringBufferSize>8192</ringBufferSize>
                    <appendTimeout>0</appendTimeout>
                </appender>
            </then>
    </if>

    <!-- TRACE > DEBUG > INFO > WARN > ERROR > OFF -->
    <!-- Root Logger -->
    <if condition='property("LOGSTASH_ENABLE").equalsIgnoreCase("true")'>
        <then>
            <root level="INFO">
                <appender-ref ref="console"/>
                <appender-ref ref="LOGSTASH"/>
            </root>
        </then>
        <else>
            <root level="INFO">
                <appender-ref ref="console"/>
                <appender-ref ref="INFO_LOG"/>
            </root>
        </else>
    </if>

</configuration>